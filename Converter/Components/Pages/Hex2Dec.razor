@page "/hex2dec"
@rendermode InteractiveServer

<h3>Перевод шестнадцатеричного числа в десятичное</h3>

<div class="mb-3">
    <input type="text" @bind="hexNumber" />
    <button @onclick="DoConvert">Перевести</button>
</div>

<p>Результат: <strong>@result</strong></p>

@code {
    private string? hexNumber = "2A";
    private string? result;

    protected override void OnInitialized()
    {
        DoConvert();
    }

    private void DoConvert()
    {
        if (string.IsNullOrWhiteSpace(hexNumber))
        {
            result = "Ошибка: пустая строка";
            return;
        }

        string hex = hexNumber.ToUpper();
        string allowed = "0123456789ABCDEF";

        foreach (char c in hex)
        {
            if (!allowed.Contains(c))
            {
                result = "Ошибка: недопустимый символ";
                return;
            }
        }

        result = Convert.ToInt32(hex, 16).ToString();
    }
}